{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Backend API",
			"type": "shell",
			"command": "Set-Location 'backend\\Api'; dotnet run",
			"isBackground": true,
			"group": "build"
		},
		{
			"label": "Run Frontend Dev Server",
			"type": "shell",
			"command": "Set-Location 'frontend'; npm run dev",
			"isBackground": true,
			"group": "build"
		}
	]
}